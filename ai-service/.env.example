# Hishab AI Service — example environment variables
# Copy this file to `.env` and adjust values. Never commit real secrets.
# PowerShell: Copy-Item .env.example .env

# Host/port for the FastAPI server
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins.
# Must include the local Node backend so it can call this service.
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001,http://localhost:5173,http://127.0.0.1:5173
